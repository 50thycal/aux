# Spotify application client id, from https://developer.spotify.com/dashboard
# There is no client secret: the app uses Authorization Code with PKCE.
SPOTIFY_CLIENT_ID=

# 32+ random characters. Encrypts the session cookie that holds the OAuth tokens.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Must match a Redirect URI registered in the Spotify dashboard, byte for byte.
#   local:    http://127.0.0.1:3000/api/auth/callback
#   deployed: https://<your-project>.vercel.app/api/auth/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# Only for running a production build over plain http on loopback.
# AUXCORD_INSECURE_COOKIES=1
